# PostgreSQL. En Supabase, usa la cadena del POOLER (puerto 6543) con sslmode=require:
# DATABASE_URL=postgresql://postgres.xxxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/vitrio

# TLS: sslmode se toma de la URL. Opciones utiles:
#   PGSSL=true            fuerza TLS aunque la URL no lo indique
#   PGSSL_VERIFY=true     verifica el certificado del servidor
#   PGSSL_CA=/ruta/ca.crt verifica contra una CA concreta (supabase-ca.crt)
PGSSL=
PGSSL_VERIFY=
PGSSL_CA=

# URL publica de la app (sin barra final). En produccion, https://vitrio.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Superadmin inicial para /setup (solo se usa si no existe ningun usuario)
ADMIN_EMAIL=admin@vitrio.app
ADMIN_PASSWORD=cambiame-ahora

# Zona horaria del negocio
BUSINESS_TIME_ZONE=Europe/Madrid

# Cron de ciclo de vida (trial -> congelado -> borrado). Cabecera x-cron-secret.
# OBLIGATORIO en produccion: sin el, el endpoint devuelve 401 (falla cerrado).
CRON_SECRET=

# Email transaccional (opcional; sin clave los avisos van al log)
RESEND_API_KEY=
EMAIL_FROM=Vitrio <no-reply@vitrio.app>

# Demo (opcional): crea el comercio bar-la-plaza con datos de ejemplo
SEED_DEMO=true

# ---------------------------------------------------------------------------
# Netlify (gratis). Ver NETLIFY.md
# En Netlify la base de datos es Supabase: usa la cadena del Transaction pooler (6543),
# por ejemplo: postgresql://postgres.<ref>:clave@aws-N-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# NETLIFY=true se pone solo en el build de Netlify.
# ---------------------------------------------------------------------------
NETLIFY=
PG_POOL_MAX=3

# Stripe Connect: la clave es de la PLATAFORMA (Vitrio). Cada comercio conecta su
# propia cuenta desde /app/ajustes y cobra en ella (cargo directo). No se guardan
# claves de comercios.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
